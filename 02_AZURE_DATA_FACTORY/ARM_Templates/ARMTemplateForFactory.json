                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "source": {
                                "type": "SqlServerSource",
                                "sqlReaderQuery": "SELECT\n    TableName,\n    WatermarkColumn,\n    LastWatermarkValue\nFROM control.WatermarkTable\nWHERE TableName = 'FactTransaction';",
                                "queryTimeout": "02:00:00",
                                "partitionOption": "None"
                            },
