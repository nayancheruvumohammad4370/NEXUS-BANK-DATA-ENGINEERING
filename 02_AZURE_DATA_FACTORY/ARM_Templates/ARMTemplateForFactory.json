                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "source": {
                                "type": "SqlServerSource",
                                "sqlReaderQuery": {
                                    "value": "@concat(\n'SELECT * FROM bank.FactTransaction WHERE TransactionDate > CONVERT(datetime2(7), ''',\nreplace(activity('Lookup_Watermark').output.firstRow.LastWatermarkValue,'Z',''),\n''', 126)'\n)",
                                    "type": "Expression"
                                },
                                "queryTimeout": "02:00:00",
                                "partitionOption": "None"
                            },
                            "sink": {
                                "type": "ParquetSink",
