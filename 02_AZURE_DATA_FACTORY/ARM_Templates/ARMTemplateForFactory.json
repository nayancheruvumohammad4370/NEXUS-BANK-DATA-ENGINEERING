                                    "pTable": "FactTransaction"
                                }
                            }
                        ],
                        "outputs": [
                            {
                                "referenceName": "DS_ADLS_DimCustomer_Bronze",
                                "type": "DatasetReference",
                                "parameters": {
                                    "pFolder": "facttransaction/incremental",
                                    "pFileName": "FactTransaction_Incremental.parquet"
                                }
                            }
                        ]
